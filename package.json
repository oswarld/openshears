{
  "name": "openshears",
  "version": "1.0.0",
  "description": "Audit the apps and AI agents connected to your accounts, keep the ones you use and revoke the rest.",
  "type": "module",
  "bin": {
    "openshears": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.*.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts && tsc --noEmit",
    "format": "prettier --write src/**/*.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "oauth",
    "permissions",
    "revoke",
    "ai-agents",
    "github",
    "security",
    "privacy",
    "openclaw",
    "cli"
  ],
  "author": "oswarld <me@oswarld.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "figlet": "^1.10.0",
    "fs-extra": "^11.2.0",
    "json5": "^2.2.3",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.2",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oswarld/openshears.git"
  },
  "homepage": "https://github.com/oswarld/openshears#readme",
  "bugs": {
    "url": "https://github.com/oswarld/openshears/issues"
  }
}
